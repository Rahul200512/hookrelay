# JDBC form. For Neon: jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/hookrelay
DATABASE_USERNAME=hookrelay
DATABASE_PASSWORD=hookrelay
# Public base URL of this deployment; used to build sink URLs.
APP_PUBLIC_URL=http://localhost:8080

# Signing secrets are encrypted at rest with this key, and the service will not start
# without it. 32 bytes, base64. Generate your own:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
